<?xml version="1.0" encoding="utf-8"?>
<!--
  UI strings, selected by the Windows display language (CultureInfo.CurrentUICulture).
  Lookup order: exact culture (e.g. "pt-BR"), then each parent in turn ("pt"), then "en".
  Chinese resolves through script parents: zh-CN/zh-SG -> zh-Hans, zh-TW/zh-HK/zh-MO -> zh-Hant.
  {0} is a placeholder for a number or another string; keep it in every translation.
-->
