<UserControl x:Class="QuickLook.Plugin.FolderViewer.FolderInfoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QuickLook.Plugin.FolderViewer"
             x:Name="infoPanel">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Design-time resources; removed when hosted by QuickLook. -->
                <ResourceDictionary Source="/QuickLook.Common;component/Styles/MainWindowStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" MinHeight="34" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <local:FileListView x:Name="fileListView" Focusable="False"
                                Foreground="{DynamicResource WindowTextForeground}" />

            <StackPanel x:Name="rootLoading" HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ProgressBar Width="150" Height="4" IsIndeterminate="True" />
                <TextBlock Margin="0,10,0,0" Text="{local:Translate ReadingFolder}"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource WindowTextForegroundAlternative}" />
            </StackPanel>

            <TextBlock x:Name="rootError" Visibility="Collapsed"
                       Margin="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource WindowTextForegroundAlternative}" />
            <Button x:Name="retryRead" Visibility="Collapsed" Content="{local:Translate Retry}"
                    Click="OnRetryRead" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12" />
        </Grid>

        <WrapPanel Grid.Row="1" Margin="12,0">

            <!-- Initial "calculating..." text is set in code: it combines two translated strings. -->
            <TextBlock x:Name="totalSize" Margin="0,6,20,6" VerticalAlignment="Center"
                       Foreground="{DynamicResource WindowTextForegroundAlternative}" />
            <TextBlock x:Name="numFolders" Margin="0,6,20,6" VerticalAlignment="Center"
                       Foreground="{DynamicResource WindowTextForegroundAlternative}" />
            <TextBlock x:Name="numFiles" Margin="0,6,20,6" VerticalAlignment="Center"
                       Foreground="{DynamicResource WindowTextForegroundAlternative}" />
            <StackPanel Margin="0,6,0,6" Orientation="Horizontal" VerticalAlignment="Center">
                <ProgressBar x:Name="statisticsProgress" Width="48" Height="3"
                             Margin="0,0,8,0" IsIndeterminate="True" />
                <TextBlock x:Name="statisticsStatus" Text="{local:Translate Status_Starting}"
                           Foreground="{DynamicResource WindowTextForegroundAlternative}" />
                <Button x:Name="continueScan" Visibility="Collapsed" Margin="8,0,0,0"
                        Content="{local:Translate ContinueScan}" Click="OnContinueStatistics" />
            </StackPanel>
        </WrapPanel>
    </Grid>
</UserControl>
