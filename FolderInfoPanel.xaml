<UserControl x:Class="QuickLook.Plugin.FolderViewer.FolderInfoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QuickLook.Plugin.FolderViewer"
             x:Name="infoPanel">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Design-time resources; removed when hosted by QuickLook. -->
                <ResourceDictionary Source="/QuickLook.Common;component/Styles/MainWindowStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <local:FileListView x:Name="fileListView" Focusable="False"
                                Foreground="{DynamicResource WindowTextForeground}" />

            <StackPanel x:Name="rootLoading" HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ProgressBar Width="150" Height="4" IsIndeterminate="True" />
                <TextBlock Margin="0,10,0,0" Text="{local:Translate ReadingFolder}"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource WindowTextForegroundAlternative}" />
            </StackPanel>

            <TextBlock x:Name="rootError" Visibility="Collapsed"
                       Margin="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource WindowTextForegroundAlternative}" />
        </Grid>

        <Grid Grid.Row="1" Margin="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Initial "calculating..." text is set in code: it combines two translated strings. -->
            <TextBlock x:Name="totalSize" Grid.Column="0" VerticalAlignment="Center"
                       Foreground="{DynamicResource WindowTextForegroundAlternative}" />
            <TextBlock x:Name="numFolders" Grid.Column="1" VerticalAlignment="Center"
                       Foreground="{DynamicResource WindowTextForegroundAlternative}" />
            <TextBlock x:Name="numFiles" Grid.Column="2" VerticalAlignment="Center"
                       Foreground="{DynamicResource WindowTextForegroundAlternative}" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <ProgressBar x:Name="statisticsProgress" Width="48" Height="3"
                             Margin="0,0,8,0" IsIndeterminate="True" />
                <TextBlock x:Name="statisticsStatus" Text="{local:Translate Status_Starting}"
                           Foreground="{DynamicResource WindowTextForegroundAlternative}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
